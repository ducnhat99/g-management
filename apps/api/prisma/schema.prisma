// Money is VND as BigInt (never float). Quantity is in chỉ (1 cây = 10 chỉ).
// CHECK constraints and row level security live in the migration SQL: Prisma cannot express them.

generator client {
  provider      = "prisma-client-js"
  // native: your machine; debian-openssl-3.0.x: the node:24-slim Docker image used on Render.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Transaction pooler (port 6543, ?pgbouncer=true) for the running app.
  url       = env("DATABASE_URL")
  // Session pooler (port 5432) for migrations.
  directUrl = env("DIRECT_URL")
}

model GoldType {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  /// Row label exactly as shown on the source site, e.g. "Vàng 9999 (nhẫn tròn)".
  sourceLabel String   @map("source_label")
  sourceUrl   String   @map("source_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  priceSnapshots PriceSnapshot[]
  purchases      Purchase[]

  @@map("gold_types")
}

model PriceSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  goldTypeId      String   @map("gold_type_id") @db.Uuid
  /// Shop buy price (what the shop pays you), VND per chỉ.
  buyPrice        BigInt   @map("buy_price")
  /// Shop sell price, VND per chỉ.
  sellPrice       BigInt   @map("sell_price")
  /// Time printed on the source site ("CẬP NHẬT LÚC ...").
  sourceUpdatedAt DateTime @map("source_updated_at") @db.Timestamptz(3)
  /// When this snapshot row was first created.
  fetchedAt       DateTime @default(now()) @map("fetched_at") @db.Timestamptz(3)
  /// Last successful check against the source, even if the price did not change.
  checkedAt       DateTime @default(now()) @map("checked_at") @db.Timestamptz(3)

  goldType GoldType @relation(fields: [goldTypeId], references: [id], onDelete: Restrict)

  // Also serves "latest snapshot per gold type" lookups.
  @@unique([goldTypeId, sourceUpdatedAt])
  @@map("price_snapshots")
}

model Purchase {
  id          String   @id @default(uuid()) @db.Uuid
  /// The family portfolio this purchase belongs to. All its members see it.
  householdId String   @map("household_id") @db.Uuid
  /// Who entered it: Supabase Auth user id (auth.users.id). No FK: auth lives in another schema.
  userId      String   @map("user_id") @db.Uuid
  goldTypeId  String   @map("gold_type_id") @db.Uuid
  quantityChi Decimal  @map("quantity_chi") @db.Decimal(10, 3)
  /// Price paid, VND per chỉ.
  unitPrice   BigInt   @map("unit_price")
  purchasedAt DateTime @map("purchased_at") @db.Date
  note        String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  goldType  GoldType  @relation(fields: [goldTypeId], references: [id], onDelete: Restrict)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, purchasedAt(sort: Desc)])
  @@map("purchases")
}

/// owner: everything incl. managing members. editor: add/edit/delete purchases. viewer: read only.
enum MemberRole {
  owner
  editor
  viewer

  @@map("member_role")
}

enum InviteStatus {
  pending
  accepted
  revoked

  @@map("invite_status")
}

/// A family portfolio shared by its members (e.g. husband and wife).
model Household {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @default("Gia đình") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members   HouseholdMember[]
  invites   HouseholdInvite[]
  purchases Purchase[]

  @@map("households")
}

model HouseholdMember {
  id          String     @id @default(uuid()) @db.Uuid
  householdId String     @map("household_id") @db.Uuid
  /// Supabase Auth user id. A user belongs to exactly one household.
  userId      String     @unique @map("user_id") @db.Uuid
  /// Copy of the auth email, refreshed from the token on each request (for member lists).
  email       String     @db.VarChar(320)
  role        MemberRole
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("household_members")
}

model HouseholdInvite {
  id          String       @id @default(uuid()) @db.Uuid
  householdId String       @map("household_id") @db.Uuid
  /// Lowercased.
  email       String       @db.VarChar(320)
  /// editor or viewer (never owner; enforced by a CHECK in the migration).
  role        MemberRole
  status      InviteStatus @default(pending)
  /// Auth user Supabase created for the invite, so revoking can delete it.
  authUserId  String?      @map("auth_user_id") @db.Uuid
  invitedBy   String       @map("invited_by") @db.Uuid
  expiresAt   DateTime     @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime?    @map("accepted_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  // At most one pending invite per email (unique partial index in the migration SQL).
  @@index([email, status])
  @@index([householdId])
  @@map("household_invites")
}
