PORT=4000
CORS_ORIGIN=http://localhost:3000

# Supabase > Connect > Transaction pooler (port 6543). Used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Supabase > Connect > Session pooler (port 5432). Used by Prisma migrate.
# Do not use the direct connection (db.<ref>.supabase.co): it is IPv6-only.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

SUPABASE_URL=https://<project-ref>.supabase.co
# Only for legacy projects that still sign JWTs with HS256. Leave empty to verify via JWKS.
SUPABASE_JWT_SECRET=

PRICE_TTL_SECONDS=3600
PRICE_FAILURE_BACKOFF_SECONDS=60

# Family invites (Supabase > Project Settings > API Keys > Secret keys, "sb_secret_..."). API only:
# never put it in the web app. Without it everything works except sending invites.
SUPABASE_SECRET_KEY=
# The web app's address; invite emails link to <WEB_APP_URL>/auth/confirm.
WEB_APP_URL=http://localhost:3000
