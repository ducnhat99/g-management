PORT=4000
CORS_ORIGIN=http://localhost:3000

# Supabase > Connect > Transaction pooler (port 6543). Used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Supabase > Connect > Session pooler (port 5432). Used by Prisma migrate.
# Do not use the direct connection (db.<ref>.supabase.co): it is IPv6-only.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

SUPABASE_URL=https://<project-ref>.supabase.co
# Only for legacy projects that still sign JWTs with HS256. Leave empty to verify via JWKS.
SUPABASE_JWT_SECRET=

PRICE_TTL_SECONDS=600
PRICE_FAILURE_BACKOFF_SECONDS=60
